# Copy to .env and fill in. Never commit .env.

# Alpaca (free account, paper-trading keys are enough): prices, splits, dividends, news
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html): macro series
FRED_API_KEY=

# SEC EDGAR needs no key, but requires a User-Agent that says who you are, with a real email
SEC_USER_AGENT=Your Name your.email@example.com

# BigQuery. Not needed for a trial run with --local
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=credentials/bigquery-key.json
BQ_DATASET=stock_data_v2

# Optional: make the Streamlit app read a --local output folder instead of BigQuery
# LOCAL_DATA_DIR=out
